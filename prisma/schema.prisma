generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Position {
  id               String   @id @default(cuid())
  symbol           String   // "510210", "AAPL", "BTC"
  name             String
  market           String   // "a_share" | "hk_stock" | "us_stock" | "crypto" | "fund"
  quantity         Float
  costPrice        Float
  direction        String?  // "long" | "short" (合约空单)
  leverage         Int?     // 杠杆倍数
  margin           Float?   // 保证金
  liquidationPrice Float?   // 强平价
  unrealizedPnl    Float?   // 未实现盈亏
  entryPrice       Float?   // 入场价（合约）
  exchangeAccountId String? // 关联交易所账号，null=手动录入
  brokerAccountId  String? // 关联券商账户
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  exchangeAccount  ExchangeAccount? @relation(fields: [exchangeAccountId], references: [id])
  brokerAccount    BrokerAccount?   @relation(fields: [brokerAccountId], references: [id])

  @@unique([symbol, market, direction, brokerAccountId])
}

model DailySnapshot {
  id          String   @id @default(cuid())
  date        String   @unique // "2026-05-14"
  totalAssets Float
  totalCost   Float
  positions   Json     // [{symbol, name, quantity, costPrice, currentPrice, ...}]
  createdAt   DateTime @default(now())
}

model Conversation {
  id        String   @id @default(cuid())
  title     String   @default("New Chat")
  messages  Json     // [{role, content}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id    String @id @default("default")
  value Json   // {llm: {baseUrl, apiKey, model}, telegram: {botToken, chatId}}
}

model ExchangeAccount {
  id             String   @id @default(cuid())
  name           String   // 用户自定义名称，如"币安主号"
  exchange       String   // "binance" | "okx" | "gate"
  apiKey         String
  apiSecret      String
  isDemo         Boolean  @default(false)
  futuresBalance Float    @default(0) // 合约钱包余额 (USDT)
  spotBalance    Float    @default(0) // 现货 USDT 余额
  fundingBalance Float    @default(0) // 资金账户余额 (USDT)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  positions Position[]
}

model BrokerAccount {
  id          String   @id @default(cuid())
  name        String   // "招商证券"
  currency    String   @default("CNY") // "CNY" | "HKD" | "USD"
  cashBalance Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  positions Position[]
  trades    Trade[]
}

model Trade {
  id              String   @id @default(cuid())
  symbol          String
  name            String
  market          String   // "a_share" | "hk_stock" | "us_stock" | "crypto" | "fund"
  side            String   // "buy" | "sell"
  quantity        Float
  price           Float    // 成交价
  costPrice       Float    // 买入成本价（卖出时用于算盈亏）
  realizedPnl     Float    @default(0) // 已实现盈亏（CNY），买入为0
  brokerAccountId String?
  manual          Boolean  @default(false)
  note            String?
  createdAt       DateTime @default(now())

  brokerAccount   BrokerAccount? @relation(fields: [brokerAccountId], references: [id])
}
