generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Position {
  id               String   @id @default(cuid())
  symbol           String   // "510210", "AAPL", "BTC"
  name             String
  market           String   // "a_share" | "hk_stock" | "us_stock" | "crypto"
  quantity         Float
  costPrice        Float
  direction        String?  // "long" | "short" (合约空单)
  leverage         Int?     // 杠杆倍数
  margin           Float?   // 保证金
  liquidationPrice Float?   // 强平价
  unrealizedPnl    Float?   // 未实现盈亏
  entryPrice       Float?   // 入场价（合约）
  exchangeAccountId String? // 关联交易所账号，null=手动录入
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  exchangeAccount  ExchangeAccount? @relation(fields: [exchangeAccountId], references: [id])

  @@unique([symbol, direction])
}

model DailySnapshot {
  id          String   @id @default(cuid())
  date        String   @unique // "2026-05-14"
  totalAssets Float
  totalCost   Float
  positions   Json     // [{symbol, name, quantity, costPrice, currentPrice, ...}]
  createdAt   DateTime @default(now())
}

model Conversation {
  id        String   @id @default(cuid())
  title     String   @default("New Chat")
  messages  Json     // [{role, content}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id    String @id @default("default")
  value Json   // {llm: {baseUrl, apiKey, model}, telegram: {botToken, chatId}}
}

model ExchangeAccount {
  id        String   @id @default(cuid())
  name      String   // 用户自定义名称，如"币安主号"
  exchange  String   // "binance" | "okx" | "gate"
  apiKey    String
  apiSecret String
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions Position[]
}
